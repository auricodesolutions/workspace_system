DATABASE_URL="mysql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME"
JWT_SECRET="replace-with-a-long-random-production-secret"
PORT=4000
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# SMTP email delivery for password resets
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user@example.com"
SMTP_PASS="replace-with-smtp-password"
MAIL_FROM="Aurilink Business Platform <no-reply@example.com>"

# Optional automated-test overrides
E2E_WEB_URL="http://localhost:3000"
E2E_API_URL="http://127.0.0.1:4000/api/v1"
E2E_ADMIN_EMAIL="admin@aurilink.local"
E2E_ADMIN_PASSWORD="ChangeMe123!"
